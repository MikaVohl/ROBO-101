<mujocoinclude>
  <default>
    <default class="arm">
      <joint damping="2" armature="0.02"/>
      <geom type="capsule" size="0.035" density="1500" rgba="0.16 0.62 0.92 1"/>
      <position kp="300" kv="35" forcerange="-100 100"/>
    </default>
    <default class="finger">
      <joint type="slide" damping="2" range="0 0.035"/>
      <geom type="box" size="0.05 0.008 0.018" density="1000" friction="2 0.01 0.001" rgba="0.22 0.25 0.3 1"/>
      <position kp="250" kv="10" ctrlrange="0 0.035" forcerange="-20 20"/>
    </default>
  </default>
  <worldbody>
    <geom name="workbench" type="box" pos="-0.85 0.65 0.5" size="0.65 0.45 0.04" rgba="0.5 0.58 0.65 1"/>
    <geom type="box" pos="-1.35 0.3 0.25" size="0.04 0.04 0.25" rgba="0.3 0.35 0.4 1"/>
    <geom type="box" pos="-0.35 1 0.25" size="0.04 0.04 0.25" rgba="0.3 0.35 0.4 1"/>
    <body name="arm_base" pos="-1.2 0.65 0.54" childclass="arm">
      <geom type="cylinder" size="0.10 0.045" pos="0 0 0.045" rgba="0.22 0.25 0.3 1"/>
      <body name="base_link" pos="0 0 0.09">
        <joint name="base_yaw" axis="0 0 1" range="-3.14 3.14"/>
        <geom fromto="0 0 0 0 0 0.12" size="0.055"/>
        <body name="upper_arm" pos="0 0 0.12">
          <joint name="shoulder" axis="0 1 0" range="-1.7 1.3"/>
          <geom fromto="0 0 0 0.3 0 0"/>
          <body name="forearm" pos="0.3 0 0">
            <joint name="elbow" axis="0 1 0" range="-2.2 2.2"/>
            <geom fromto="0 0 0 0.27 0 0"/>
            <body name="wrist_roll_link" pos="0.27 0 0">
              <joint name="wrist_roll" axis="1 0 0" range="-3.14 3.14"/>
              <geom fromto="0 0 0 0.08 0 0" size="0.028" rgba="0.22 0.25 0.3 1"/>
              <body name="wrist_pitch_link" pos="0.08 0 0">
                <joint name="wrist_pitch" axis="0 1 0" range="-1.8 1.8"/>
                <geom fromto="0 0 0 0.07 0 0" size="0.028"/>
                <body name="tool" pos="0.07 0 0">
                  <joint name="tool_roll" axis="1 0 0" range="-3.14 3.14"/>
                  <geom type="box" size="0.025 0.025 0.025" pos="0.025 0 0" rgba="0.22 0.25 0.3 1"/>
                  <site name="end_effector" pos="0.12 0 0" size="0.012" rgba="0.2 1 0.6 1"/>
                  <body name="left_finger" pos="0.085 0.012 0" childclass="finger">
                    <joint name="finger_left" axis="0 1 0"/>
                    <geom/>
                  </body>
                  <body name="right_finger" pos="0.085 -0.012 0" childclass="finger">
                    <joint name="finger_right" axis="0 -1 0"/>
                    <geom/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="red_cube" pos="-0.55 0.5 0.57">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" mass="0.08" friction="1.5 0.01 0.001" rgba="1 0.3 0.25 1"/>
    </body>
    <body name="yellow_cube" pos="-0.45 0.8 0.57">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" mass="0.08" rgba="1 0.75 0.2 1"/>
    </body>
  </worldbody>
  <contact>
    <!-- The rotating column deliberately meets the fixed mounting plate. -->
    <exclude body1="arm_base" body2="base_link"/>
  </contact>
  <actuator>
    <position name="base_yaw_cmd" joint="base_yaw" class="arm" ctrlrange="-3.14 3.14"/>
    <position name="shoulder_cmd" joint="shoulder" class="arm" ctrlrange="-1.7 1.3"/>
    <position name="elbow_cmd" joint="elbow" class="arm" ctrlrange="-2.2 2.2"/>
    <position name="wrist_roll_cmd" joint="wrist_roll" class="arm" ctrlrange="-3.14 3.14"/>
    <position name="wrist_pitch_cmd" joint="wrist_pitch" class="arm" ctrlrange="-1.8 1.8"/>
    <position name="tool_roll_cmd" joint="tool_roll" class="arm" ctrlrange="-3.14 3.14"/>
    <position name="finger_left_cmd" joint="finger_left" class="finger"/>
    <position name="finger_right_cmd" joint="finger_right" class="finger"/>
  </actuator>
</mujocoinclude>
